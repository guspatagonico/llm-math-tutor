# VITE_BASE_PATH: Subfolder where the app is deployed.
# Set to "/" for root deployment, or "/webapps/llm-math-tutor/" for subfolders.
# Vite uses this to prefix all asset URLs (JS, CSS, images).
VITE_BASE_PATH="/webapps/llm-math-tutor/"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Google Analytics 4 measurement ID (client-side tracking).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
